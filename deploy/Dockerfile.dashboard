# Stage 1: Build dashboard SPA bundle
FROM node:22-alpine AS build
WORKDIR /app

# Copy dependency manifests
COPY modules/ui/dashboard/package*.json ./

# Install dependencies using clean install
RUN npm ci

# Copy dashboard source files
COPY modules/ui/dashboard/ ./

# Build production SPA assets
RUN npm run build

# Stage 2: Serve SPA via unprivileged Nginx
FROM nginxinc/nginx-unprivileged:alpine AS runtime

# Copy custom Nginx configuration
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled SPA client assets
COPY --from=build /app/build/client /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
